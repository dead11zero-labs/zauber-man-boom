[sub_resource type="Resource" id="z0"]
script = ExtResource("2")
sprecher = "Mechy McBoom"
text = "HALT. Besucher erkannt. Ich bin Mechy McBoom, Sicherheitsdienst am Empfang. Bitte nichts anzünden, nichts sprengen, nichts aufladen, was nicht ausdrücklich dafür vorgesehen ist."
audio = ""
antworten = PackedStringArray()
antwort_ziele = PackedInt32Array()

[sub_resource type="Resource" id="z1"]
script = ExtResource("2")
sprecher = "Mechy McBoom"
text = "Der Aufzug steht hinter der Sicherheitsschleuse. Etage wählen, einsteigen, nicht auf Knöpfe hämmern. Mein Name ist übrigens reine Ironie. Meistens."
audio = ""
antworten = PackedStringArray()
antwort_ziele = PackedInt32Array()

[resource]
script = ExtResource("1")
id = "mechy"
ueberspringbar = true
zeilen = Array[Resource]([SubResource("z0"), SubResource("z1")])
